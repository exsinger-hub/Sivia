{
  "description": "One optional Sivia Star invitation after installation; never changes a GitHub account.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL((process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT) + '/hooks/welcome.mjs').href)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
