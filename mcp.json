{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "drawio-live": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/live-server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}"
    },
    "drawio-file-utils": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}"
    },
    "powerpoint-live": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/powerpoint-server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
